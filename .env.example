# PostgreSQL connection (required)
DATABASE_URI=postgresql://mcp_readonly:CHANGE_ME@localhost:5432/yourdb?sslmode=require

# Access mode: restricted (read-only, default) or unrestricted (dev only)
ACCESS_MODE=restricted

# Comma-separated schema allowlist (empty = all user schemas)
ALLOWED_SCHEMAS=public

# Query and response limits
MAX_ROWS=1000
MAX_CELL_CHARS=500
QUERY_TIMEOUT_SEC=30

# Connection pool
POOL_MIN_SIZE=2
POOL_MAX_SIZE=10

# MCP transport: stdio | sse | streamable-http
TRANSPORT=stdio

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_SQL=false

# HTTP transport (when TRANSPORT != stdio)
SSE_HOST=localhost
SSE_PORT=8000
STREAMABLE_HTTP_HOST=localhost
STREAMABLE_HTTP_PORT=8000
